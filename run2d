#!/bin/zsh
# Run a local fcode match, then open the replay in the Cambridge Battlecode 2D
# visualiser (instead of fcode's 3D one). The .replay26 wire format is shared
# between the two engines (verified: identical proto field IDs for everything
# both know about; fcode-only fields are skipped by the viewer).
#
# Usage:
#   ./run2d BOT_A BOT_B [MAP_PATH] [fcode run options...]   # run match, then view
#   ./run2d                                                 # just view replay.replay26
#   ./run2d some.replay26                                   # just view that replay
#
# Examples:
#   ./run2d loki Khaos maps/sweden.map26
#   ./run2d loki loki --seed 7
set -e
cd "${0:A:h}"

FCODE=.venv/bin/fcode
CAMBC=~/Documents/GitHub/Cambridge-Battlecode/venv/bin/cambc
REPLAY=replay.replay26

if [[ ! -x $CAMBC ]]; then
    echo "cambc not found at $CAMBC" >&2
    exit 1
fi

if (( $# == 0 )); then
    exec $CAMBC watch $REPLAY
elif [[ $# == 1 && $1 == *.replay26 ]]; then
    exec $CAMBC watch "$1"
fi

$FCODE run "$@"
exec $CAMBC watch $REPLAY
