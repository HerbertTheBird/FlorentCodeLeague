#!/bin/zsh
# Run a local fcode match, then open the replay in the Cambridge 2D visualiser
# (bundled in tools/visualiser2d, patched for Titan's 2x2 core) instead of
# fcode's 3D one. The .replay26 wire format is shared between the two engines.
#
# Usage:
#   ./run2d BOT_A BOT_B [MAP_PATH] [fcode run options...]   # run match, then view
#   ./run2d                                                 # just view replay.replay26
#   ./run2d some.replay26                                   # just view that replay
#
# Examples:
#   ./run2d loki Khaos maps/sweden.map26
#   ./run2d loki loki --seed 7
set -e
cd "${0:A:h}"

REPLAY=replay.replay26

if (( $# == 0 )); then
    exec python3 tools/watch2d.py $REPLAY
elif [[ $# == 1 && $1 == *.replay26 ]]; then
    exec python3 tools/watch2d.py "$1"
fi

if [[ -x .venv/bin/fcode ]]; then
    FCODE=.venv/bin/fcode
elif (( $+commands[fcode] )); then
    FCODE=$commands[fcode]
else
    print -u2 "run2d: fcode not found; create .venv or install fcode on PATH"
    exit 127
fi

# Bots live in three places now -- bots/ is the active submission alone, and
# everything else is under frozen/{champions,opponents,archive}. Resolve the
# first two arguments through tools/botpath.py so bare names keep working
# (./run2d Heimdall_v6 loki) wherever the bot actually sits. Anything that does
# not resolve is passed through untouched, so paths and flags still work.
resolve_bot() {
    local p
    if p=$(python3 tools/botpath.py "$1" 2>/dev/null); then
        print -r -- "$p"
    else
        print -r -- "$1"
    fi
}

if (( $# >= 2 )); then
    A=$(resolve_bot "$1"); B=$(resolve_bot "$2"); shift 2
    set -- "$A" "$B" "$@"
fi

"$FCODE" run "$@"
exec python3 tools/watch2d.py $REPLAY
