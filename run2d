#!/bin/zsh
# Run a local fcode match, then open the replay in the Cambridge 2D visualiser
# (bundled in tools/visualiser2d, patched for Titan's 2x2 core) instead of
# fcode's 3D one. The .replay26 wire format is shared between the two engines.
#
# Usage:
#   ./run2d BOT_A BOT_B [MAP_PATH] [fcode run options...]   # run match, then view
#   ./run2d                                                 # just view replay.replay26
#   ./run2d some.replay26                                   # just view that replay
#
# Examples:
#   ./run2d loki Khaos maps/sweden.map26
#   ./run2d loki loki --seed 7
set -e
cd "${0:A:h}"

REPLAY=replay.replay26

if (( $# == 0 )); then
    exec python3 tools/watch2d.py $REPLAY
elif [[ $# == 1 && $1 == *.replay26 ]]; then
    exec python3 tools/watch2d.py "$1"
fi

.venv/bin/fcode run "$@"
exec python3 tools/watch2d.py $REPLAY
